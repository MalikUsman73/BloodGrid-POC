# Normalise line endings so the repository stays consistent across machines.
# Without this, files authored on Windows land in the repo with CRLF and show
# as wholly modified when cloned on macOS or Linux.
* text=auto eol=lf

# Binary assets — never munge these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Generated: collapse in pull-request diffs.
package-lock.json linguist-generated=true diff=lockfile
